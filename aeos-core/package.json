{
  "name": "@lycha/aeos",
  "version": "1.0.0",
  "description": "An AI-assisted development pipeline that takes a ticket from idea to code review using specialised LLM agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aeos": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/e2e",
    "!dist/**/*.test.*",
    "!dist/**/*.smoke-test.*",
    "!dist/**/*.fixture.*",
    "templates",
    "cli-contract.yaml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run schemas && tsc --project tsconfig.json && npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "dev": "tsc --watch --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "schemas": "node ../plugins/artefact-tree-pipeline/scripts/seed-schemas.mjs --tree templates --force",
    "schemas:check": "node ../plugins/artefact-tree-pipeline/scripts/seed-schemas.mjs --tree templates --check",
    "lint": "npm run schemas:check && eslint 'src/**/*.{ts,tsx}' && prettier --check src/",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix && prettier --write src/",
    "typecheck": "tsc --noEmit",
    "verify:contract": "tsx src/cli/contract/main.ts",
    "generate:cli": "node scripts/generate-cli.mjs",
    "verify:generated": "node scripts/generate-cli.mjs --check",
    "smoke-test": "npx tsx src/infrastructure/executor/claude-cli-executor.smoke-test.ts",
    "smoke-test:auggie": "npx tsx src/infrastructure/executor/auggie-cli-executor.smoke-test.ts",
    "smoke-test:opencode": "npx tsx src/infrastructure/executor/opencode-cli-executor.smoke-test.ts"
  },
  "keywords": [],
  "author": "Krzysztof Jackowski",
  "homepage": "http://aeosdev.com/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lycha/aeos.git",
    "directory": "aeos-core"
  },
  "bugs": {
    "url": "https://github.com/lycha/aeos/issues"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.3",
    "ajv": "^8.20.0",
    "esbuild": "^0.24.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "ink-testing-library": "^4.0.0",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "ink": "^7.0.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "simple-git": "^3.35.2",
    "zod": "^4.3.6"
  }
}
